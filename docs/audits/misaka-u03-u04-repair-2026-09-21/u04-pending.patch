+
+    msg = message([ToolCall(id="fixture", name="probe", arguments=arguments)])
+    if provider == "anthropic":
+        wire = anthropic.convert_messages([msg], model(), False)
+        actual = wire[0]["content"][0]["input"]
+    elif provider == "google":
+        wire = google_shared.convert_messages(model("google-generative-ai"), Context(messages=[msg]))
+        actual = wire[0]["parts"][0]["functionCall"]["args"]
+    else:
+        wire = mistral.to_chat_messages([msg], False)
+        actual = json.loads(wire[0]["toolCalls"][0]["function"]["arguments"])
+    if provider == "mistral":
+        expected = arguments if isinstance(arguments, (dict, list)) or arguments else {}
+    else:
+        expected = arguments if arguments is not None else {}
+    assert actual == expected
+

+"""Offline parity corpus generated by the pinned, unmodified Pi parser."""
+
+import json
+import math
+from pathlib import Path
+
+import pytest
+
+from misaka.ai.utils import json_parse
+
+_CORPUS = json.loads(
+    (Path(__file__).parent / "fixtures" / "pi_json_parse_c7cdb460.json").read_text()
+)
+
+
+def _encode(value):
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            return {"$number": "NaN" if math.isnan(value) else "Infinity" if value > 0 else "-Infinity"}
+        if value == 0 and math.copysign(1, value) < 0:
+            return {"$number": "-0"}
+    if isinstance(value, list):
+        return [_encode(item) for item in value]
+    if isinstance(value, dict):
+        return {key: _encode(item) for key, item in value.items()}
+    return value
+
+
+@pytest.mark.parametrize("case", _CORPUS["cases"], ids=lambda case: str(case["id"]))
+def test_parse_matches_pinned_pi(case):
+    assert _encode(json_parse.parse_streaming_json(case["raw"])) == case["expected"]
+
+
+@pytest.mark.parametrize("case", _CORPUS["cases"], ids=lambda case: str(case["id"]))
+def test_final_arguments_match_pinned_pi(case):
+    args = json_parse.StreamingArgs(case["raw"] or "")
+    assert _encode(args.finish()) == case["expected"]
+
+
+def test_streaming_parse_stays_throttled_and_finishes_exactly(monkeypatch):
+    raw = json.dumps({"content": "x" * 40000})
+    parse = json_parse.parse_streaming_json
+    lengths = []
+
+    def counted(value):
+        lengths.append(len(value))
+        return parse(value)
+
+    monkeypatch.setattr(json_parse, "parse_streaming_json", counted)
+    args = json_parse.StreamingArgs()
+    for offset in range(0, len(raw), 20):
+        args.append(raw[offset:offset + 20])
+        _ = args.arguments
+    assert args.finish() == json.loads(raw)
+    assert len(lengths) < 140
+    assert lengths[-1] == len(raw)
+
+
+def test_small_fragment_still_updates_immediately():
+    args = json_parse.StreamingArgs()
+    args.append('{"path":"f')
+    assert args.arguments == {"path": "f"}
+    args.append('ile"}')
+    assert args.finish() == {"path": "file"}
+
+
+def test_integral_sse_indexes_stay_python_integers():
+    # The shared complete parser also decodes provider SSE event envelopes.
+    event = json_parse.parse_json_with_repair('{"index":0,"usage":{"output_tokens":1}}')
+    assert type(event["index"]) is int
+    assert type(event["usage"]["output_tokens"]) is int

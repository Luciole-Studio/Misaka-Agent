@_serialized
def set_workspace(con, task_id, workspace, generation=None, claim_lock=None):
    clauses = ["id=?"]
    values = [workspace, task_id]
    if generation is not None:
        clauses.append("generation=?")
        values.append(generation)
    if claim_lock is not None:

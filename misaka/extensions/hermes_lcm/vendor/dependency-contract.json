{
  "schema_version": 1,
  "contract_version": "1.0.4",
  "boundary": "host-owned",
  "imported_api_validation": "observed-coverage-only",
  "description": "Hermes-LCM is a source-installed Hermes Agent plugin. Hermes Agent owns the Python environment and dependency resolution; the plugin declares the host and optional feature imports it consumes without creating a second package installer or lock.",
  "ownership": {
    "dependency_resolver": "Hermes Agent host environment",
    "update_owner": "Hermes-LCM maintainers",
    "update_trigger": "Review and increment this contract when the imported-API assurance policy, a scanned runtime import, supported Python or Hermes Agent version, or required imported API changes."
  },
  "supported_versions": {
    "python": [
      "3.11",
      "3.12",
      "3.13",
      "3.14"
    ],
    "hermes_agent": ">=0.16,<1",
    "optional_dependency_policy": "The supported version is the version resolved by a supported Hermes Agent host when the listed imported API is present. Hermes-LCM does not independently pin or install optional packages."
  },
  "runtime_scan": {
    "globs": [
      "*.py",
      "benchmarking/**/*.py",
      "scripts/**/*.py"
    ],
    "local_imports": [
      "hermes_lcm",
      "benchmarking"
    ],
    "excluded": [
      "tests/**",
      "benchmarks/**"
    ]
  },
  "external_imports": {
    "agent": {
      "distribution": "hermes-agent",
      "availability": "required",
      "scope": "plugin-runtime",
      "version_policy": "Hermes Agent >=0.16,<1",
      "imported_api": [
        "agent.context_engine.ContextEngine",
        "agent.auxiliary_client.call_llm",
        "agent.context_compressor"
      ]
    },
    "fastembed": {
      "distribution": "fastembed",
      "availability": "optional",
      "scope": "fastembed embedding provider",
      "version_policy": "host-resolved; supported when fastembed.TextEmbedding accepts model_name, cache_dir, and local_files_only",
      "imported_api": [
        "fastembed.TextEmbedding"
      ]
    },
    "gateway": {
      "distribution": "hermes-agent",
      "availability": "optional",
      "scope": "task-local slash-command session metadata",
      "version_policy": "Hermes Agent >=0.16,<1; falls back to environment metadata when the module is absent",
      "imported_api": [
        "gateway.session_context.get_session_env"
      ]
    },
    "hermes_cli": {
      "distribution": "hermes-agent",
      "availability": "optional",
      "scope": "host home, provider routing, and plugin hook integration",
      "version_policy": "Hermes Agent >=0.16,<1; each compatibility path has an explicit fallback",
      "imported_api": [
        "hermes_cli.auth.PROVIDER_REGISTRY",
        "hermes_cli.config.get_hermes_home",
        "hermes_cli.plugins.get_plugin_manager",
        "hermes_cli.runtime_provider._get_named_custom_provider"
      ]
    },
    "huggingface_hub": {
      "distribution": "huggingface-hub",
      "availability": "optional",
      "scope": "LongMemEval dataset fetch command only",
      "version_policy": "host-resolved; supported when huggingface_hub.hf_hub_download accepts repo_id, filename, repo_type, revision, and local_dir",
      "imported_api": [
        "huggingface_hub.hf_hub_download"
      ]
    },
    "numpy": {
      "distribution": "numpy",
      "availability": "optional",
      "scope": "vector acceleration with pure-Python fallback",
      "version_policy": "host-resolved; supported when numpy provides frombuffer, zeros, asarray, argpartition, and packbits",
      "imported_api": [
        "numpy.frombuffer",
        "numpy.zeros",
        "numpy.asarray",
        "numpy.argpartition",
        "numpy.packbits"
      ]
    },
    "regex": {
      "distribution": "regex",
      "availability": "optional",
      "scope": "bounded regular-expression matching",
      "version_policy": "host-resolved; supported when compiled Pattern.search accepts timeout",
      "imported_api": [
        "regex.compile",
        "regex.Pattern.search(timeout=...)",
        "regex.DOTALL",
        "regex.IGNORECASE",
        "regex.MULTILINE",
        "regex.VERBOSE",
        "regex.error"
      ]
    },
    "tiktoken": {
      "distribution": "tiktoken",
      "availability": "optional",
      "scope": "token counting with character-estimate fallback",
      "version_policy": "host-resolved; supported when tiktoken.get_encoding('cl100k_base') is available",
      "imported_api": [
        "tiktoken.get_encoding"
      ]
    },
    "yaml": {
      "distribution": "PyYAML",
      "availability": "optional",
      "scope": "YAML configuration and benchmark policies",
      "version_policy": "host-resolved; supported when yaml.safe_load and yaml.safe_dump are available",
      "imported_api": [
        "yaml.safe_load",
        "yaml.safe_dump"
      ]
    },
    "misaka": {
      "distribution": "misaka",
      "availability": "required",
      "scope": "Native host paths, context ABC and explicit operator entry points",
      "version_policy": "same source checkout as this bundled plugin",
      "imported_api": [
        "misaka.extensions.hermes_lcm.host.config_bridge.load_config",
        "misaka.extensions.hermes_lcm.host.context_engine_abc",
        "misaka.extensions.hermes_lcm.vendor.command._VOYAGE_USD_PER_MILLION_TOKENS",
        "misaka.extensions.hermes_lcm.vendor.config.LCMConfig",
        "misaka.extensions.hermes_lcm.vendor.dag.build_nodes_fts_spec",
        "misaka.extensions.hermes_lcm.vendor.db_bootstrap.ensure_external_content_fts",
        "misaka.extensions.hermes_lcm.vendor.db_bootstrap.refuse_schema_version_too_new",
        "misaka.extensions.hermes_lcm.vendor.externalize._replace_externalized_payload",
        "misaka.extensions.hermes_lcm.vendor.externalize.find_externalized_payload_for_message",
        "misaka.extensions.hermes_lcm.vendor.externalize.get_large_output_storage_dir",
        "misaka.extensions.hermes_lcm.vendor.externalize.is_externalized_placeholder",
        "misaka.extensions.hermes_lcm.vendor.ingest_protection._contains_media_payload",
        "misaka.extensions.hermes_lcm.vendor.ingest_protection.extract_all_externalized_payload_refs",
        "misaka.extensions.hermes_lcm.vendor.ingest_protection.protect_message_for_ingest",
        "misaka.extensions.hermes_lcm.vendor.ingest_protection.redact_sensitive_value",
        "misaka.extensions.hermes_lcm.vendor.ingest_protection.sensitive_pattern_status",
        "misaka.extensions.hermes_lcm.vendor.message_content.normalize_content_value",
        "misaka.extensions.hermes_lcm.vendor.store.MessageStore",
        "misaka.extensions.hermes_lcm.vendor.store._normalize_source_value",
        "misaka.extensions.hermes_lcm.vendor.tokens.count_message_tokens",
        "misaka.extensions.hermes_lcm.vendor.tokens.count_tokens",
        "misaka.extensions.hermes_lcm.vendor.trajectory_store",
        "misaka.extensions.hermes_lcm.vendor.trajectory_store.CorpusIdentity",
        "misaka.extensions.hermes_lcm.vendor.trajectory_store.TrajectoryStore",
        "misaka.extensions.hermes_lcm.vendor.trajectory_store.create_trajectory_embedding_provider"
      ]
    }
  },
  "evidence": {
    "python_ci_matrix": ".github/workflows/ci.yml",
    "operator_contract": "docs/dependency-assurance.md",
    "validator": "scripts/validate_dependency_contract.py",
    "validation_command": "python scripts/validate_dependency_contract.py --report-environment"
  }
}

.venv*/
__pycache__/
*.pyc
.DS_Store
.coverage
# Benchmark runs are local artefacts; the frozen baseline is not.

# libghostty-vt build tree (scripts/build_libghostty_vt.sh)
/build/

# Claude Code session checkpoints
/.claude/

# build artefacts
/dist/

# Disposable project LCM cache and content-free lifetime locks
/.misaka/lcm/
/.misaka/lcm.gate
/.misaka/lcm.activity.sqlite*

# Development records (plans, audits, ledgers): kept on the developer's machine, not published
/docs/plans/
/docs/audits/

# The reading engine is built from source; only sources and the lockfile are published.
/packages/reading/node_modules/
/packages/reading/dist/

# A reading run's graph, node bodies and sessions belong to the reader, not the repository.
/reading/
